# --- Database -----------------------------------------------------------
# Connection string for the PostgreSQL instance used by Drizzle ORM.
# DATABASE_URL is preferred. POSTGRES_URL is also accepted so the app works
# with the standard Supabase ↔ Vercel integration variables.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# POSTGRES_URL=postgresql://postgres.project-ref:password@pooler-host:6543/postgres

# --- Auth -----------------------------------------------------------------
# Random 32+ byte secret used to sign session tokens (JWT/HMAC).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-secret

# --- App & transactional email ----------------------------------------------
# Canonical public URL used to generate absolute links in production emails.
APP_URL=https://your-domain.example
# RESEND_API_KEY=re_...
# Verified sender, e.g. "SAMURAI <account@your-domain.example>"
# EMAIL_FROM=SAMURAI <account@your-domain.example>

# --- Samurai AI -------------------------------------------------------------
# Without this key the app runs fully functional, AI features gracefully
# fall back to a "provider not configured" state (no fake responses).
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Attachments storage (future providers) --------------------------------
# BLOB_READ_WRITE_TOKEN=

NODE_ENV=development
