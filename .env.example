# --- Database -----------------------------------------------------------
# Connection string for the PostgreSQL instance used by Drizzle ORM.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Auth -----------------------------------------------------------------
# Random 32+ byte secret used to sign session tokens (JWT/HMAC).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-secret

# --- Samurai AI -------------------------------------------------------------
# Without this key the app runs fully functional, AI features gracefully
# fall back to a "provider not configured" state (no fake responses).
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Attachments storage (future providers) --------------------------------
# BLOB_READ_WRITE_TOKEN=

NODE_ENV=development
